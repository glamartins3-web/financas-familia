<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Controle Financeiro Pessoal</title>
  <style>
    :root {
      --bg-color: #f4f7f6;
      --card-bg: #ffffff;
      --secondary-bg: #f7fafc;
      --table-header-bg: #edf2f7;
      --sidebar-bg: #1a365d;
      --sidebar-hover: #2b6cb0;
      --text-main: #2d3748;
      --text-muted: #718096;
      --primary: #1a365d;
      --income: #2f855a;
      --income-light: #c6f6d5;
      --expense: #c53030;
      --expense-light: #fed7d7;
      --pending: #d69e2e;
      --pending-light: #fefcbf;
      --active-bg: #c6f6d5;
      --active-color: #2f855a;
      --inactive-bg: #edf2f7;
      --inactive-color: #718096;
      --border: #e2e8f0;
      --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    body.dark-mode {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --secondary-bg: #1e293b;
      --table-header-bg: #334155;
      --sidebar-bg: #090d16;
      --sidebar-hover: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #38bdf8;
      --income: #34d399;
      --income-light: rgba(52, 211, 153, 0.15);
      --expense: #f87171;
      --expense-light: rgba(248, 113, 113, 0.15);
      --pending: #fbbf24;
      --pending-light: rgba(251, 191, 36, 0.15);
      --active-bg: rgba(52, 211, 153, 0.15);
      --active-color: #34d399;
      --inactive-bg: #334155;
      --inactive-color: #94a3b8;
      --border: #334155;
      --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; transition: background-color 0.2s, color 0.2s, border-color 0.2s; }
    body { background-color: var(--bg-color); color: var(--text-main); display: flex; min-height: 100vh; overflow-x: hidden; }

    #login-screen {
      display: flex; justify-content: center; align-items: center; height: 100vh; padding: 16px;
      position: fixed; top: 0; left: 0; width: 100%; background-color: var(--bg-color); z-index: 3000;
    }
    .login-card {
      background: var(--card-bg); padding: 24px; border-radius: 12px;
      box-shadow: var(--shadow); width: 100%; max-width: 400px; border: 1px solid var(--border);
    }
    .login-card h2 { color: var(--primary); margin-bottom: 20px; text-align: center; font-size: 1.4rem; }
    .error-msg { color: var(--expense); font-size: 0.85rem; margin-bottom: 12px; text-align: center; display: none; }

    #app-container { display: flex; width: 100%; position: relative; min-width: 0; }

    .sidebar {
      width: 260px; max-width: 82vw; background-color: var(--sidebar-bg); color: white;
      position: fixed; top: 0; left: -260px; height: 100%;
      transition: left 0.3s ease-in-out; display: flex; flex-direction: column; z-index: 2000;
      box-shadow: 4px 0 15px rgba(0,0,0,0.2);
    }
    .sidebar.open { left: 0; }

    .sidebar-overlay {
      display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.5); z-index: 1500;
    }
    .sidebar-overlay.active { display: block; }

    .sidebar-header {
      padding: 18px 16px; display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .sidebar-title { font-size: 1.05rem; font-weight: bold; }
    .close-sidebar-btn { background: none; border: none; color: white; font-size: 1.4rem; cursor: pointer; padding: 4px 8px; }

    .nav-list { list-style: none; padding: 10px 0; }
    .nav-item {
      display: flex; align-items: center; padding: 15px 20px; color: #e2e8f0; cursor: pointer; transition: background 0.2s;
    }
    .nav-item:hover, .nav-item.active { background-color: var(--sidebar-hover); color: white; font-weight: bold; }
    .nav-item .icon { font-size: 1.2rem; margin-right: 14px; min-width: 20px; text-align: center; }

    .main-wrapper { flex: 1; padding: 12px; width: 100%; min-width: 0; overflow-y: auto; }

    header {
      margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
      background: var(--card-bg); padding: 10px 14px; border-radius: 8px; box-shadow: var(--shadow); border: 1px solid var(--border);
    }
    .header-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .menu-btn {
      background: var(--secondary-bg); border: 1px solid var(--border); padding: 8px 11px; border-radius: 6px;
      font-size: 1.15rem; cursor: pointer; color: var(--primary); flex-shrink: 0;
    }
    header h1 { color: var(--primary); font-size: 1.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .user-info { font-size: 0.82rem; color: var(--text-muted); font-weight: 600; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .theme-toggle-btn { background: var(--secondary-bg); border: 1px solid var(--border); padding: 6px 9px; border-radius: 6px; cursor: pointer; font-size: 0.95rem; color: var(--text-main); }
    .btn-logout { background: none; border: none; color: var(--expense); cursor: pointer; font-size: 0.8rem; text-decoration: underline; padding: 4px; }

    .tab-view { display: none; }
    .tab-view.active { display: block; }

    .dashboard-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px; }
    @media (min-width: 640px) {
      .dashboard-cards { grid-template-columns: repeat(4, 1fr); gap: 12px; }
    }
    .card { background: var(--card-bg); padding: 14px; border-radius: 10px; box-shadow: var(--shadow); border: 1px solid var(--border); min-width: 0; }
    .card h3 { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px; }
    .card .value { font-size: 1.1rem; font-weight: bold; word-break: break-word; }
    @media (min-width: 640px) {
      .card { padding: 16px; }
      .card .value { font-size: 1.3rem; }
    }
    .card.income .value { color: var(--income); }
    .card.expense .value { color: var(--expense); }
    .card.balance.positive .value { color: var(--income); }
    .card.balance.negative .value { color: var(--expense); }

    .main-grid { display: grid; grid-template-columns: 1fr; gap: 16px; align-items: start; }
    @media (min-width: 900px) {
      .main-grid { grid-template-columns: 330px 1fr; gap: 20px; align-items: start; }
      header { margin-bottom: 24px; padding: 12px 16px; }
      header h1 { font-size: 1.75rem; }
      .main-wrapper { padding: 24px; }
      .dashboard-cards { margin-bottom: 20px; }
      .main-grid > .form-section {
        position: sticky;
        top: 20px;
        margin-bottom: 0;
      }
    }

    .form-section, .list-section, .rule-section, .card-section {
      background: var(--card-bg); padding: 14px; border-radius: 10px; box-shadow: var(--shadow); border: 1px solid var(--border); margin-bottom: 16px; min-width: 0;
    }
    @media (min-width: 900px) {
      .form-section, .list-section, .rule-section, .card-section { padding: 18px; margin-bottom: 20px; }
    }

    .rule-section h2, .form-section h2, .card-section h2 { font-size: 1.05rem; margin-bottom: 12px; }

    .list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px; }
    .list-header h2 { margin-bottom: 0; font-size: 1.05rem; }

    .status-counter { font-size: 0.72rem; font-weight: bold; color: var(--text-main); background: var(--table-header-bg); padding: 6px 10px; border-radius: 6px; width: 100%; text-align: center; }
    @media (min-width: 520px) {
      .status-counter { width: auto; text-align: left; font-size: 0.75rem; }
    }
    .status-counter span.paid { color: var(--income); }
    .status-counter span.pend { color: var(--pending); }

    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 4px; color: var(--text-main); }
    .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; outline: none; font-size: 16px; background: var(--card-bg); color: var(--text-main); }
    @media (min-width: 900px) {
      .form-group input, .form-group select { font-size: 0.95rem; }
    }

    .filter-box { background: var(--secondary-bg); border: 1px dashed var(--primary); padding: 10px; border-radius: 8px; margin-bottom: 14px; }
    .filter-box h3 { font-size: 0.78rem; color: var(--primary); margin-bottom: 6px; text-transform: uppercase; }
    .filter-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

    button.btn-submit { width: 100%; padding: 12px; background-color: var(--primary); color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.95rem; }
    button.btn-submit:disabled { background-color: #a0aec0; cursor: not-allowed; }

    .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%; }
    table { width: 100%; border-collapse: collapse; text-align: left; min-width: 480px; }
    th, td { padding: 9px 10px; border-bottom: 1px solid var(--border); font-size: 0.82rem; color: var(--text-main); vertical-align: middle; }
    @media (min-width: 768px) {
      th, td { padding: 10px 12px; font-size: 0.85rem; }
    }
    th { background-color: var(--table-header-bg); color: var(--primary); white-space: nowrap; }

    .tag { padding: 3px 6px; border-radius: 4px; font-size: 0.68rem; font-weight: bold; display: inline-block; }
    .tag.receita { background-color: var(--income-light); color: var(--income); }
    .tag.despesa-fixa { background-color: var(--inactive-bg); color: var(--text-muted); }
    .tag.despesa-variavel { background-color: var(--expense-light); color: var(--expense); }
    .tag.investimento { background-color: var(--income-light); color: var(--primary); }
    .tag.assinatura { background-color: var(--pending-light); color: var(--pending); }

    .status-badge { padding: 6px 8px; border-radius: 5px; font-size: 0.72rem; font-weight: bold; cursor: pointer; border: none; white-space: nowrap; }
    .status-badge.ativo { background-color: var(--active-bg); color: var(--active-color); }
    .status-badge.inativo { background-color: var(--inactive-bg); color: var(--inactive-color); }
    .status-badge.pago { background-color: var(--income-light); color: var(--income); }
    .status-badge.pendente { background-color: var(--pending-light); color: var(--pending); }
    .status-badge.atrasado { background-color: var(--expense-light); color: var(--expense); }

    .btn-delete { background: none; border: none; color: var(--expense); cursor: pointer; font-weight: bold; font-size: 1.2rem; padding: 4px 8px; }

    .rule-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
    @media (min-width: 640px) { .rule-grid { grid-template-columns: repeat(3, 1fr); } }
    .rule-card { padding: 10px; border-radius: 8px; background: var(--secondary-bg); border: 1px solid var(--border); }
    .rule-card h4 { font-size: 0.8rem; color: var(--primary); }
    .rule-card p { font-size: 0.75rem; color: var(--text-muted); margin-top: 3px; }

    .card-header-row { background-color: var(--table-header-bg); font-weight: bold; cursor: pointer; }
    .sub-item-row { background-color: var(--secondary-bg); font-size: 0.8rem; }
    .sub-item-row td { padding-left: 20px; color: var(--text-muted); }
    .tree-icon { margin-right: 6px; font-weight: bold; display: inline-block; width: 12px; }
  </style>
</head>
<body>

  <!-- TELA DE LOGIN -->
  <div id="login-screen">
    <div class="login-card">
      <h2>Acesso ao Sistema</h2>
      <div class="error-msg" id="login-error">Usuário ou senha incorretos</div>
      <form id="login-form">
        <div class="form-group"><label>Usuário</label><input type="text" id="login-user" placeholder="Ex: admin" required></div>
        <div class="form-group"><label>Senha</label><input type="password" id="login-pass" placeholder="Sua senha" required></div>
        <button type="submit" class="btn-submit" id="btn-login-submit">Entrar</button>
      </form>
    </div>
  </div>

  <div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>

  <div id="app-container">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-title">Menu Principal</span>
        <button class="close-sidebar-btn" onclick="toggleSidebar()">✕</button>
      </div>
      <ul class="nav-list">
        <li class="nav-item active" onclick="switchTab('tab-geral', this)"><span class="icon">📊</span><span class="text">Gestão Geral</span></li>
        <li class="nav-item" onclick="switchTab('tab-cartoes', this)"><span class="icon">💳</span><span class="text">Gestão de Cartões</span></li>
        <li class="nav-item" onclick="switchTab('tab-assinaturas', this)"><span class="icon">🔁</span><span class="text">Gestão de Assinaturas</span></li>
      </ul>
    </aside>

    <main class="main-wrapper">
      <header>
        <div class="header-left">
          <button class="menu-btn" onclick="toggleSidebar()" title="Abrir Menu">☰</button>
          <h1 id="view-title">Gestão Geral</h1>
        </div>
        <div class="user-info">
          <button class="theme-toggle-btn" onclick="toggleTheme()" title="Alternar Modo Escuro/Claro">🌓</button>
          <span id="user-display-name"></span>
          <button class="btn-logout" onclick="logout()">Sair</button>
        </div>
      </header>

      <!-- GUIA 1: GESTÃO GERAL -->
      <section id="tab-geral" class="tab-view active">
        <div class="dashboard-cards">
          <div class="card income"><h3>Receitas</h3><div class="value" id="total-income">R$ 0,00</div></div>
          <div class="card expense"><h3>Despesas</h3><div class="value" id="total-expense">R$ 0,00</div></div>
          <div class="card balance" id="card-balance"><h3>Saldo</h3><div class="value" id="total-balance">R$ 0,00</div></div>
          <div class="card"><h3>Economizado</h3><div class="value" id="total-saved">0%</div></div>
        </div>

        <div class="rule-section">
          <h2>Regra 50 / 30 / 20</h2>
          <div class="rule-grid">
            <div class="rule-card"><h4>50% - Fixas</h4><p>Ideal: <strong id="rule-50-target">R$ 0,00</strong></p><p>Atual: <span id="rule-50-actual">R$ 0,00</span></p></div>
            <div class="rule-card"><h4>30% - Variáveis</h4><p>Ideal: <strong id="rule-30-target">R$ 0,00</strong></p><p>Atual: <span id="rule-30-actual">R$ 0,00</span></p></div>
            <div class="rule-card"><h4>20% - Investimentos</h4><p>Ideal: <strong id="rule-20-target">R$ 0,00</strong></p><p>Atual: <span id="rule-20-actual">R$ 0,00</span></p></div>
          </div>
        </div>

        <div class="main-grid">
          <div class="form-section">
            <div class="filter-box">
              <h3>Filtros</h3>
              <div class="filter-grid">
                <div>
                  <label style="font-size:0.7rem; font-weight:600;">Mês</label>
                  <select id="filter-month" onchange="renderTransactions()">
                    <option value="all">Todos</option>
                    <option value="01">Jan</option><option value="02">Fev</option><option value="03">Mar</option><option value="04">Abr</option>
                    <option value="05">Mai</option><option value="06">Jun</option><option value="07">Jul</option><option value="08">Ago</option>
                    <option value="09">Set</option><option value="10">Out</option><option value="11">Nov</option><option value="12">Dez</option>
                  </select>
                </div>
                <div>
                  <label style="font-size:0.7rem; font-weight:600;">Ano</label>
                  <select id="filter-year" onchange="renderTransactions()"><option value="all">Todos</option></select>
                </div>
              </div>
            </div>

            <h2>Nova Transação</h2>
            <form id="finance-form">
              <div class="form-group"><label>Descrição</label><input type="text" id="description" placeholder="Ex: Salário, Mercado" required></div>
              <div class="form-group"><label>Valor (R$)</label><input type="number" id="amount" step="0.01" placeholder="0,00" required></div>
              <div class="form-group">
                <label>Tipo</label>
                <select id="type" onchange="toggleCardSelect()" required>
                  <option value="Receita">Receita</option>
                  <option value="Despesa Fixa">Despesa Fixa (Necessidades)</option>
                  <option value="Despesa Variável">Despesa Variável (Desejos/Lazer)</option>
                  <option value="Investimento">Investimento/Economia (20%)</option>
                </select>
              </div>
              <div class="form-group" id="card-select-group" style="display:none;">
                <label>Cartão de Crédito</label>
                <select id="card"><option value="Nenhum">Nenhum / Dinheiro / PIX</option></select>
              </div>
              <div class="form-group">
                <label>Categoria</label>
                <select id="category" required>
                  <option value="Salário">Salário</option><option value="Renda Extra">Renda Extra</option><option value="Moradia">Moradia</option>
                  <option value="Alimentação">Alimentação</option><option value="Transporte">Transporte</option><option value="Saúde">Saúde</option>
                  <option value="Lazer">Lazer</option><option value="Assinaturas">Assinaturas</option><option value="Investimentos">Investimentos</option><option value="Outros">Outros</option>
                </select>
              </div>
              <div class="form-group"><label>Data Inicial</label><input type="date" id="date" required></div>
              <div class="form-group">
                <label>Repetir por (Meses)</label>
                <input type="number" id="recurrence-months" value="1" min="1" max="60" required>
                <small style="color:var(--text-muted); font-size:0.75rem;">1 = Apenas este mês, >1 = Repete nos meses seguintes</small>
              </div>
              <button type="submit" class="btn-submit" id="btn-submit">Adicionar Transação</button>
            </form>
          </div>

          <div class="list-section">
            <div class="list-header">
              <h2>Transações</h2>
              <div class="status-counter" id="status-counter">
                PAGO: <span class="paid" id="counter-paid">R$ 0,00</span> | PEND: <span class="pend" id="counter-pend">R$ 0,00</span>
              </div>
            </div>
            <div class="table-responsive">
              <table>
                <thead><tr><th>Data</th><th>Descrição</th><th>Tipo/Valor</th><th>Status</th><th>Ações</th></tr></thead>
                <tbody id="transaction-list"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- GUIA 2: GESTÃO DE CARTÕES -->
      <section id="tab-cartoes" class="tab-view">
        <div class="main-grid">
          <div class="form-section">
            <h2>Cadastrar Novo Cartão</h2>
            <form id="card-form" onsubmit="addCreditCard(event)">
              <div class="form-group"><label>Nome do Cartão</label><input type="text" id="new-card-name" placeholder="Ex: Nubank" required></div>
              <div class="form-group"><label>Final (Dígitos)</label><input type="text" id="new-card-final" placeholder="Ex: 1234"></div>
              <div class="form-group"><label>Vencimento</label><input type="text" id="new-card-due" placeholder="Ex: Dia 15" required></div>
              <button type="submit" class="btn-submit">Cadastrar Cartão</button>
            </form>
          </div>
          <div class="card-section">
            <h2>Faturas por Cartão (Visão Guarda-Chuva)</h2>
            <div class="table-responsive">
              <table>
                <thead><tr><th>Nome</th><th>Final</th><th>Venc.</th><th>Fatura Atual</th></tr></thead>
                <tbody id="credit-cards-tree"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- GUIA 3: GESTÃO DE ASSINATURAS -->
      <section id="tab-assinaturas" class="tab-view">
        <div class="main-grid">
          <div class="form-section">
            <h2>Cadastrar Assinatura</h2>
            <form id="subscription-form" onsubmit="addSubscription(event)">
              <div class="form-group"><label>Serviço / Assinatura</label><input type="text" id="sub-name" placeholder="Ex: Netflix" required></div>
              <div class="form-group"><label>Valor Mensal (R$)</label><input type="number" id="sub-amount" step="0.01" placeholder="0,00" required></div>
              <div class="form-group"><label>Cartão de Crédito</label><select id="sub-card"><option value="Nenhum">Nenhum</option></select></div>
              <div class="form-group"><label>Dia de Vencimento / Início</label><input type="date" id="sub-date" required></div>
              <button type="submit" class="btn-submit">Salvar Assinatura</button>
            </form>
          </div>
          <div class="card-section">
            <h2>Assinaturas e Serviços Recorrentes</h2>
            <div class="table-responsive">
              <table>
                <thead>
                  <tr>
                    <th>Venc.</th>
                    <th>Serviço / Cartão</th>
                    <th>Valor</th>
                    <th>Total 12x (Ano)</th>
                    <th>Status (Ativo/Inativo)</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody id="subscriptions-list"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>

  <script>
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwpPi1fadTOdK0ErMk9WVNKk_8b1m_1Udd64M91YqPI7Thg9kx6zDVZ9xTWNf59ZKY/exec';

    let registeredCards = [];
    let transactions = [];
    let subscriptions = [];

    if (localStorage.getItem('theme') === 'dark') {
      document.body.classList.add('dark-mode');
    }

    function toggleTheme() {
      document.body.classList.toggle('dark-mode');
      const isDark = document.body.classList.contains('dark-mode');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('open');
      document.getElementById('sidebar-overlay').classList.toggle('active');
    }

    function switchTab(tabId, element) {
      document.querySelectorAll('.tab-view').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      element.classList.add('active');
      const titleMap = { 'tab-geral': 'Gestão Geral', 'tab-cartoes': 'Gestão de Cartões', 'tab-assinaturas': 'Gestão de Assinaturas' };
      document.getElementById('view-title').textContent = titleMap[tabId];
      toggleSidebar();
    }

    const loggedUser = JSON.parse(localStorage.getItem('currentUser'));
    if (loggedUser) { showApp(loggedUser); }

    document.getElementById('login-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const usuario = document.getElementById('login-user').value.trim().toLowerCase();
      const senha = document.getElementById('login-pass').value.trim();
      const btnLogin = document.getElementById('btn-login-submit');
      const errorMsg = document.getElementById('login-error');

      btnLogin.disabled = true;
      btnLogin.textContent = 'Validando...';
      errorMsg.style.display = 'none';

      try {
        const response = await fetch(SCRIPT_URL + '?action=getUsers');
        const sheetUsers = await response.json();
        const foundUser = sheetUsers.find(u => String(u.usuario).trim().toLowerCase() === usuario && String(u.senha).trim() === senha);

        if (foundUser) {
          if (!foundUser.ativo) {
            errorMsg.textContent = 'Usuário inativo na planilha.';
            errorMsg.style.display = 'block';
          } else {
            const userData = { nome: foundUser.nome || foundUser.usuario, usuario: foundUser.usuario };
            localStorage.setItem('currentUser', JSON.stringify(userData));
            showApp(userData);
          }
        } else {
          if (usuario === 'admin' && senha === '1234') {
            const userData = { nome: 'Glauber', usuario: 'admin' };
            localStorage.setItem('currentUser', JSON.stringify(userData));
            showApp(userData);
          } else {
            errorMsg.textContent = 'Usuário ou senha inválidos.';
            errorMsg.style.display = 'block';
          }
        }
      } catch (err) {
        if (usuario === 'admin' && senha === '1234') {
          const userData = { nome: 'Glauber', usuario: 'admin' };
          localStorage.setItem('currentUser', JSON.stringify(userData));
          showApp(userData);
        } else {
          errorMsg.textContent = 'Erro de conexão.';
          errorMsg.style.display = 'block';
        }
      } finally {
        btnLogin.disabled = false;
        btnLogin.textContent = 'Entrar';
      }
    });

    async function showApp(user) {
      document.getElementById('login-screen').style.display = 'none';
      document.getElementById('user-display-name').textContent = user.nome;
      document.getElementById('date').valueAsDate = new Date();
      if(document.getElementById('sub-date')) document.getElementById('sub-date').valueAsDate = new Date();
      
      await loadDataFromSheet();
    }

    function logout() {
      localStorage.removeItem('currentUser');
      document.getElementById('login-screen').style.display = 'flex';
      document.getElementById('login-form').reset();
    }

    async function loadDataFromSheet() {
      try {
        const res = await fetch(SCRIPT_URL + '?action=getData');
        const data = await res.json();
        if (data.cards) registeredCards = data.cards;
        if (data.transactions) transactions = data.transactions;
        if (data.subscriptions) subscriptions = data.subscriptions;
        
        updateCardSelects();
        populateYearFilter();
        setDefaultCurrentMonthYear();
        renderTransactions();
        renderSubscriptions();
      } catch (err) {
        console.error("Erro ao carregar dados da planilha", err);
      }
    }

    function updateCardSelects() {
      const selects = [document.getElementById('card'), document.getElementById('sub-card')];
      selects.forEach(sel => {
        if (!sel) return;
        sel.innerHTML = '<option value="Nenhum">Nenhum / Dinheiro / PIX</option>';
        registeredCards.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.name;
          opt.textContent = `${c.name} ${c.final !== '-' ? '('+c.final+')' : ''}`;
          sel.appendChild(opt);
        });
      });
    }

    async function addCreditCard(e) {
      e.preventDefault();
      const name = document.getElementById('new-card-name').value.trim();
      const final = document.getElementById('new-card-final').value.trim() || '-';
      const due = document.getElementById('new-card-due').value.trim();
      if (!name || !due) return;

      const payload = { action: 'addCard', name, final, due };
      registeredCards.push({ name, final, due });
      updateCardSelects();
      document.getElementById('card-form').reset();
      renderTransactions();

      await fetch(SCRIPT_URL, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    }

    async function addSubscription(e) {
      e.preventDefault();
      const description = document.getElementById('sub-name').value.trim();
      const amount = parseFloat(document.getElementById('sub-amount').value);
      const card = document.getElementById('sub-card').value;
      const date = document.getElementById('sub-date').value;

      if (!description || isNaN(amount) || !date) return;

      const payload = {
        id: 'id_sub_' + Date.now(),
        description, amount, type: 'Assinatura', category: 'Assinaturas', date, card, status: 'Ativo', payStatus: 'Pendente'
      };

      subscriptions.push(payload);
      if (payload.status === 'Ativo') {
        transactions.push({
          id: payload.id, date: payload.date, description: payload.description,
          category: 'Assinaturas', amount: payload.amount, type: 'Despesa Variável', card: payload.card, status: payload.payStatus
        });
      }

      renderSubscriptions();
      renderTransactions();
      document.getElementById('subscription-form').reset();
      document.getElementById('sub-date').valueAsDate = new Date();

      await fetch(SCRIPT_URL, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    }

    async function toggleSubStatus(index) {
      const sub = subscriptions[index];
      sub.status = sub.status === 'Ativo' ? 'Inativo' : 'Ativo';
      
      transactions = transactions.filter(t => t.id !== sub.id);
      if (sub.status === 'Ativo') {
        transactions.push({
          id: sub.id, date: sub.date, description: sub.description,
          category: 'Assinaturas', amount: sub.amount, type: 'Despesa Variável', card: sub.card, status: sub.payStatus || 'Pendente'
        });
      }

      renderSubscriptions();
      renderTransactions();

      await fetch(SCRIPT_URL, {
        method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'toggleSubStatus', id: sub.id, status: sub.status })
      });
    }

    async function removeSubscription(index) {
      const sub = subscriptions[index];
      subscriptions.splice(index, 1);
      transactions = transactions.filter(t => t.id !== sub.id);

      renderSubscriptions();
      renderTransactions();

      await fetch(SCRIPT_URL, {
        method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', id: sub.id, type: 'Assinatura' })
      });
    }

    function toggleCardSelect() {
      const type = document.getElementById('type').value;
      document.getElementById('card-select-group').style.display = ['Despesa Variável', 'Investimento', 'Despesa Fixa'].includes(type) ? 'block' : 'none';
    }

    function populateYearFilter() {
      const currentYear = new Date().getFullYear();
      const years = new Set([currentYear, currentYear - 1, currentYear + 1]);
      transactions.forEach(t => { if (t.date) { const y = t.date.split('-')[0]; if (y) years.add(parseInt(y)); } });
      const sortedYears = Array.from(years).sort((a, b) => b - a);
      const filterYear = document.getElementById('filter-year');
      filterYear.innerHTML = '<option value="all">Todos</option>';
      sortedYears.forEach(y => {
        const option = document.createElement('option');
        option.value = y.toString();
        option.textContent = y.toString();
        filterYear.appendChild(option);
      });
    }

    function setDefaultCurrentMonthYear() {
      const now = new Date();
      document.getElementById('filter-month').value = String(now.getMonth() + 1).padStart(2, '0');
      document.getElementById('filter-year').value = now.getFullYear().toString();
    }

    function formatCurrency(val) {
      return Number(val || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function getEffectiveStatus(t) {
      if (t.type === 'Receita') return 'N/A';
      if (t.status === 'Pago') return 'Pago';
      if (t.date) {
        const [tYear, tMonth] = t.date.split('-');
        const now = new Date();
        if (tYear < String(now.getFullYear()) || (tYear === String(now.getFullYear()) && tMonth < String(now.getMonth() + 1).padStart(2, '0'))) {
          return 'Atrasado';
        }
      }
      return t.status || 'Pendente';
    }

    function getFilteredTransactions() {
      const selMonth = document.getElementById('filter-month').value;
      const selYear = document.getElementById('filter-year').value;

      return transactions.filter(t => {
        if (!t.date) return true;
        const [year, month] = t.date.split('-');

        if (selMonth === 'all' && selYear === 'all') return true;
        if (selMonth === 'all') return year === selYear;
        if (selYear === 'all') return month === selMonth;

        return month === selMonth && year === selYear;
      });
    }

    function renderCardsTree(filteredData) {
      const treeBody = document.getElementById('credit-cards-tree');
      treeBody.innerHTML = '';
      if (registeredCards.length === 0) {
        treeBody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:var(--text-muted);">Nenhum cartão cadastrado.</td></tr>`;
        return;
      }
      registeredCards.forEach((c, idx) => {
        const cardExpenses = filteredData.filter(t => t.card === c.name);
        const cardTotal = cardExpenses.reduce((sum, item) => sum + item.amount, 0);

        const trCard = document.createElement('tr');
        trCard.className = 'card-header-row';
        trCard.onclick = () => toggleSubItems(`card-sub-${idx}`, `icon-${idx}`);
        trCard.innerHTML = `<td><span class="tree-icon" id="icon-${idx}">▶</span>${c.name}</td><td>${c.final}</td><td>${c.due}</td><td style="color: var(--expense); font-weight: bold;">${formatCurrency(cardTotal)}</td>`;
        treeBody.appendChild(trCard);

        if (cardExpenses.length === 0) {
          const trEmpty = document.createElement('tr');
          trEmpty.className = `sub-item-row card-sub-${idx}`;
          trEmpty.style.display = 'none';
          trEmpty.innerHTML = `<td colspan="4" style="font-style: italic; color: var(--text-muted);">↳ Sem gastos no período</td>`;
          treeBody.appendChild(trEmpty);
        } else {
          cardExpenses.forEach(exp => {
            const trSub = document.createElement('tr');
            trSub.className = `sub-item-row card-sub-${idx}`;
            trSub.style.display = 'none';
            trSub.innerHTML = `<td colspan="3">↳ ${exp.description} (${exp.date.split('-').reverse().join('/')})</td><td style="font-weight: bold;">${formatCurrency(exp.amount)}</td>`;
            treeBody.appendChild(trSub);
          });
        }
      });
    }

    function renderSubscriptions() {
      const subsBody = document.getElementById('subscriptions-list');
      subsBody.innerHTML = '';

      if (subscriptions.length === 0) {
        subsBody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">Nenhuma assinatura cadastrada.</td></tr>`;
        return;
      }

      subscriptions.forEach((s, idx) => {
        const tr = document.createElement('tr');
        const statusClass = s.status === 'Ativo' ? 'ativo' : 'inativo';
        const annualTotal = Number(s.amount || 0) * 12;

        tr.innerHTML = `
          <td>${s.date ? s.date.split('-').reverse().join('/') : ''}</td>
          <td><strong>${s.description}</strong><br><small style="color:var(--primary)">💳 ${s.card || 'Outros'}</small></td>
          <td style="font-weight: bold; color: var(--expense);">${formatCurrency(s.amount)}</td>
          <td style="font-weight: bold; color: var(--primary);">${formatCurrency(annualTotal)}</td>
          <td><button class="status-badge ${statusClass}" onclick="toggleSubStatus(${idx})">${s.status}</button></td>
          <td><button class="btn-delete" onclick="removeSubscription(${idx})">&times;</button></td>
        `;
        subsBody.appendChild(tr);
      });
    }

    function toggleSubItems(className, iconId) {
      const rows = document.getElementsByClassName(className);
      const icon = document.getElementById(iconId);
      let isHidden = false;
      for (let r of rows) {
        if (r.style.display === 'none') { r.style.display = 'table-row'; isHidden = true; } else { r.style.display = 'none'; }
      }
      icon.textContent = isHidden ? '▼' : '▶';
    }

    function updateDashboard(filteredData) {
      const income = filteredData.filter(t => t.type === 'Receita').reduce((acc, t) => acc + t.amount, 0);
      const expenses = filteredData.filter(t => t.type.startsWith('Despesa')).reduce((acc, t) => acc + t.amount, 0);
      const invested = filteredData.filter(t => t.type === 'Investimento').reduce((acc, t) => acc + t.amount, 0);
      const balance = income - (expenses + invested);
      const savedPercent = income > 0 ? (((income - expenses) / income) * 100).toFixed(1) : 0;

      document.getElementById('total-income').textContent = formatCurrency(income);
      document.getElementById('total-expense').textContent = formatCurrency(expenses);
      document.getElementById('total-balance').textContent = formatCurrency(balance);
      document.getElementById('total-saved').textContent = `${savedPercent}%`;
      document.getElementById('card-balance').className = balance >= 0 ? 'card balance positive' : 'card balance negative';

      const fixedExpenses = filteredData.filter(t => t.type === 'Despesa Fixa').reduce((acc, t) => acc + t.amount, 0);
      const variableExpenses = filteredData.filter(t => t.type === 'Despesa Variável' && (!t.card || t.card === 'Nenhum')).reduce((acc, t) => acc + t.amount, 0);
      
      let totalCardsExpenses = 0;
      registeredCards.forEach(c => {
        totalCardsExpenses += filteredData.filter(t => t.card === c.name).reduce((sum, item) => sum + item.amount, 0);
      });

      const totalVariableAndCards = variableExpenses + totalCardsExpenses;

      document.getElementById('rule-50-target').textContent = formatCurrency(income * 0.50);
      document.getElementById('rule-50-actual').textContent = formatCurrency(fixedExpenses);
      document.getElementById('rule-30-target').textContent = formatCurrency(income * 0.30);
      document.getElementById('rule-30-actual').textContent = formatCurrency(totalVariableAndCards);
      document.getElementById('rule-20-target').textContent = formatCurrency(income * 0.20);
      document.getElementById('rule-20-actual').textContent = formatCurrency(invested);

      let totalPaid = 0, totalPend = 0;
      filteredData.forEach(t => {
        if (t.type !== 'Receita' && (!t.card || t.card === 'Nenhum')) {
          if (getEffectiveStatus(t) === 'Pago') totalPaid += t.amount;
          else totalPend += t.amount;
        }
      });
      document.getElementById('counter-paid').textContent = formatCurrency(totalPaid);
      document.getElementById('counter-pend').textContent = formatCurrency(totalPend);

      renderCardsTree(filteredData);
    }

    function renderTransactions() {
      const transactionList = document.getElementById('transaction-list');
      transactionList.innerHTML = '';
      const filteredData = getFilteredTransactions();

      const processedList = [];
      const cardGroups = {};

      filteredData.forEach(t => {
        if (t.card && t.card !== 'Nenhum') {
          const monthYearKey = (t.date ? t.date.substring(0, 7) : 'geral') + '_' + t.card;
          if (!cardGroups[monthYearKey]) {
            cardGroups[monthYearKey] = {
              id: 'card_agg_' + monthYearKey,
              monthYearKey: monthYearKey,
              date: t.date,
              description: t.card,
              category: 'Cartão de Crédito',
              amount: 0,
              type: t.type,
              card: t.card,
              itemIds: [],
              statuses: []
            };
            processedList.push(cardGroups[monthYearKey]);
          }
          cardGroups[monthYearKey].amount += t.amount;
          cardGroups[monthYearKey].itemIds.push(t.id);
          cardGroups[monthYearKey].statuses.push(getEffectiveStatus(t));
        } else {
          processedList.push(t);
        }
      });

      processedList.forEach((t) => {
        const originalIndex = transactions.findIndex(item => item.id === t.id);
        const tr = document.createElement('tr');
        const typeClass = t.type.toLowerCase().replace(' ', '-');
        
        let statusHtml = '-';
        if (t.type !== 'Receita') {
          if (t.card && t.card !== 'Nenhum') {
            const allPaid = t.statuses.length > 0 && t.statuses.every(s => s === 'Pago');
            const anyDelayed = t.statuses.some(s => s === 'Atrasado');
            let effStatus = allPaid ? 'Pago' : (anyDelayed ? 'Atrasado' : 'Pendente');
            let statusClass = effStatus === 'Pago' ? 'pago' : (effStatus === 'Atrasado' ? 'atrasado' : 'pendente');
            
            statusHtml = `<button class="status-badge ${statusClass}" onclick="toggleCardStatus('${t.monthYearKey}', '${effStatus}')">${effStatus}</button>`;
          } else {
            const effStatus = getEffectiveStatus(t);
            let statusClass = effStatus === 'Pago' ? 'pago' : (effStatus === 'Atrasado' ? 'atrasado' : 'pendente');
            statusHtml = `<button class="status-badge ${statusClass}" onclick="toggleStatus(${originalIndex})">${effStatus}</button>`;
          }
        }

        tr.innerHTML = `
          <td>${t.date ? t.date.split('-').reverse().join('/') : ''}</td>
          <td><strong>${t.description}</strong><br><small style="color:var(--text-muted)">${t.category}</small></td>
          <td><span class="tag ${typeClass}">${t.type}</span><br><strong>${formatCurrency(t.amount)}</strong></td>
          <td>${statusHtml}</td>
          <td>${t.card && t.card !== 'Nenhum' ? '<small style="color:var(--text-muted)">-</small>' : '<button class="btn-delete" onclick="removeTransaction('+originalIndex+')">&times;</button>'}</td>
        `;
        transactionList.appendChild(tr);
      });

      updateDashboard(filteredData);
    }

    document.getElementById('finance-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const description = document.getElementById('description').value;
      const amount = parseFloat(document.getElementById('amount').value);
      const type = document.getElementById('type').value;
      const category = document.getElementById('category').value;
      const baseDateStr = document.getElementById('date').value;
      const card = document.getElementById('card').value;
      const repeatMonths = parseInt(document.getElementById('recurrence-months').value) || 1;

      if (!description || isNaN(amount) || !baseDateStr) return;

      const itemsToCreate = [];
      const baseDate = new Date(baseDateStr + 'T00:00:00');

      for (let i = 0; i < repeatMonths; i++) {
        let d = new Date(baseDate.getFullYear(), baseDate.getMonth() + i, baseDate.getDate());
        let year = d.getFullYear();
        let month = String(d.getMonth() + 1).padStart(2, '0');
        let day = String(d.getDate()).padStart(2, '0');
        let formattedDate = `${year}-${month}-${day}`;

        let itemDesc = description;
        if (repeatMonths > 1) {
          itemDesc = `${description} (${i + 1}/${repeatMonths})`;
        }

        itemsToCreate.push({
          id: 'id_' + Date.now() + '_' + i,
          description: itemDesc,
          amount,
          type,
          category,
          date: formattedDate,
          card: (type === 'Receita') ? 'Nenhum' : card,
          status: type === 'Receita' ? 'N/A' : 'Pendente'
        });
      }

      itemsToCreate.forEach(item => transactions.push(item));
      populateYearFilter();
      renderTransactions();
      this.reset();
      document.getElementById('date').valueAsDate = new Date();
      document.getElementById('recurrence-months').value = "1";
      toggleCardSelect();

      await fetch(SCRIPT_URL, {
        method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsToCreate })
      });
    });

    async function toggleStatus(index) {
      const item = transactions[index];
      if (!item || item.type === 'Receita') return;
      
      const currentEff = getEffectiveStatus(item);
      item.status = (currentEff === 'Pago') ? 'Pendente' : 'Pago';
      
      const sub = subscriptions.find(s => s.id === item.id);
      if (sub) { sub.payStatus = item.status; renderSubscriptions(); }

      renderTransactions();

      await fetch(SCRIPT_URL, {
        method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'toggleStatus', id: item.id, type: item.type, status: item.status })
      });
    }

    async function toggleCardStatus(monthYearKey, currentStatus) {
      const newStatus = (currentStatus === 'Pago') ? 'Pendente' : 'Pago';
      
      const [yearMonth, ...cardNameParts] = monthYearKey.split('_');
      const cardName = cardNameParts.join('_');

      const targetIds = [];
      transactions.forEach(t => {
        if (t.card === cardName && t.date && t.date.substring(0, 7) === yearMonth) {
          t.status = newStatus;
          targetIds.push(t.id);
          
          const sub = subscriptions.find(s => s.id === t.id);
          if (sub) sub.payStatus = newStatus;
        }
      });

      renderSubscriptions();
      renderTransactions();

      await fetch(SCRIPT_URL, {
        method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'toggleCardStatus', ids: targetIds, status: newStatus })
      });
    }

    async function removeTransaction(index) {
      const removedItem = transactions[index];
      if (!removedItem || (removedItem.card && removedItem.card !== 'Nenhum')) return;
      transactions.splice(transactions.findIndex(t => t.id === removedItem.id), 1);
      renderTransactions();

      await fetch(SCRIPT_URL, {
        method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', id: removedItem.id, type: removedItem.type })
      });
    }
  </script>
</body>
</html>
